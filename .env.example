# Supabase Postgres connection string (Settings -> Database -> Connection string -> URI).
# Use the "Transaction pooler" (port 6543) string for best compatibility.
DATABASE_URL=postgresql://postgres:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# OpenRouter — used as the main LLM (query rewriting + answers) via the
# OpenAI SDK pointed at OpenRouter's endpoint, so free (:free) models work.
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# "openrouter/free" is OpenRouter's auto-router: it picks a free model per
# request. This only seeds the initial value the first time the app reads
# its settings — after that, the model is controlled from the Settings
# screen (The Method -> Model) and stored in the database, not read from
# this env var again. Change it here if you want a different first-run
# default; change it in Settings to actually switch models later.
OPENROUTER_MODEL=openrouter/free

# Optional. Reranking is skipped (falls back to vector similarity) if unset or if the call fails.
# https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Optional. Free/open-source web search for Agent mode via SearXNG - a
# self-hosted or public instance's URL, no API key. This only seeds the
# first-ever value; change it in Settings ("The Method" -> Agent mode ->
# Web search) after that, same pattern as OPENROUTER_MODEL. Its JSON API is
# off by default even on public instances, so self-hosting is the reliable
# option: docker run -p 8080:8080 searxng/searxng, then add "json" to
# search.formats in its settings.yml. Leave unset to not offer web search.
SEARXNG_BASE_URL=

# Strongly recommended anywhere other than your own machine. When set, the
# whole app (pages and API, including the Danger Zone) requires HTTP Basic
# auth with these credentials. Leave unset for local-only use.
APP_PASSWORD=
# Optional, defaults to "admin".
APP_USERNAME=

# Optional per-file upload limit in megabytes (default 25).
MAX_UPLOAD_MB=

# Optional. Local embedding model. Default: Xenova/multilingual-e5-small
# (~100 languages, cross-language search). Xenova/all-MiniLM-L6-v2 is the
# older English-only model. Changing it makes the background worker
# re-embed every document on the next start.
EMBEDDING_MODEL=

# Optional. Languages for OCR of scanned PDF pages, tesseract codes joined
# with "+" (default eng+ita). Each needs its data package installed:
# npm install @tesseract.js-data/fra
OCR_LANGUAGES=

# Optional. Set to 1 to not run the background worker inside the web
# server, e.g. on serverless hosting; then run `npm run worker` separately.
DISABLE_BACKGROUND_WORKER=

# Optional. Seconds to wait before retry n of a failed background job is
# n x this (default 30).
JOB_RETRY_DELAY_SECONDS=
